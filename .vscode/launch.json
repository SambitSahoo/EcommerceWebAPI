{
  "version": "0.2.0",
  "compounds": [
    {
      "name": "Run All Microservices",
      "configurations": [
        "Catalog.API",
        "Basket.API",
        "Discount.API",
        "Order.API"
      ]
    }
  ],
  "configurations": [
    {
      "name": "Catalog.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-compose: up",
      "program": "${workspaceFolder}/Services/Catalog/Catalog.API/bin/Debug/net8.0/Catalog.API.dll",
      "cwd": "${workspaceFolder}/Services/Catalog/Catalog.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Basket.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-compose: up",
      "program": "${workspaceFolder}/Services/Basket/Basket.API/bin/Debug/net8.0/Basket.API.dll",
      "cwd": "${workspaceFolder}/Services/Basket/Basket.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Discount.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-compose: up",
      "program": "${workspaceFolder}/Services/Discount/Discount.API/bin/Debug/net8.0/Discount.API.dll",
      "cwd": "${workspaceFolder}/Services/Discount/Discount.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "Order.API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "docker-compose: up",
      "program": "${workspaceFolder}/Services/Order/Order.API/bin/Debug/net8.0/Order.API.dll",
      "cwd": "${workspaceFolder}/Services/Order/Order.API",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    {
      "name": ".NET Core Attach",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}

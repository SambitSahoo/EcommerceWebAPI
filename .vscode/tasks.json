{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "docker-compose: up",
      "type": "process",
      "command": "docker-compose",
      "args": ["-f", "${workspaceFolder}/docker-compose.yml", "up", "-d"],
      "problemMatcher": []
    },
    {
      "label": "build",
      "command": "dotnet",
      "type": "process",
      "args": ["build", "${workspaceFolder}/Ecommerce.sln"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run Catalog.API",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "Services/Catalog/Catalog.API"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run Basket.API",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "Services/Basket/Basket.API"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run Discount.API",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "Services/Discount/Discount.API"],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run Order.API",
      "type": "process",
      "command": "dotnet",
      "args": ["run", "--project", "Services/Order/Order.API"],
      "problemMatcher": "$msCompile"
    }
  ]
}
